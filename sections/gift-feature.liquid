          "type": "text",
          "id": "subheading",
          "label": "t:sections.gift-feature.settings.subheading.label"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:sections.gift-feature.settings.text.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.gift-feature.presets.name",
      "blocks": [
        { "type": "hero" },
        { "type": "products" },
        { "type": "faq" },
        { "type": "cta" }
      ]
    }
  ]
}
{% endschema %}
