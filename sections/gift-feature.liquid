{% comment %}
  [カスタマイズ] 特集ページ（LP）用セクション
  メインビジュアル・商品ピックアップ・FAQ（アコーディオン）・CTA・テキストを、ブロックとして自由に追加・並べ替えできる
{% endcomment %}
{{ 'section-gift-feature.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- assign products_anchor_used = false -%}
<div class="gift-feature color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  {%- for block in section.blocks -%}
    {%- case block.type -%}
      {%- when 'hero' -%}
        <div
          class="gift-feature__hero color-{{ block.settings.color_scheme }} gradient gift-feature__hero--{{ block.settings.text_alignment }}{% if block.settings.full_width %} gift-feature__hero--full{% else %} page-width{% endif %}"
          style="--hero-overlay: {{ block.settings.overlay_opacity | divided_by: 100.0 }}; --hero-min-height: {{ block.settings.min_height }}vh;"
          {{ block.shopify_attributes }}
        >
          <div class="gift-feature__hero-media{% if block.settings.full_width == false %} global-media-settings{% endif %}">
            {%- if block.settings.image != blank -%}
              {%- liquid
                assign hero_loading = 'lazy'
                assign hero_priority = 'auto'
                if forloop.first
                  assign hero_loading = 'eager'
                  assign hero_priority = 'high'
                endif
              -%}
              {{
                block.settings.image
                | image_url: width: 2400
                | image_tag:
                  widths: '375, 550, 750, 1100, 1500, 1800, 2400',
                  sizes: '100vw',
                  loading: hero_loading,
                  fetchpriority: hero_priority,
                  class: 'gift-feature__hero-image'
              }}
            {%- else -%}
              {{ 'hero-apparel-1' | placeholder_svg_tag: 'gift-feature__hero-image placeholder-svg' }}
            {%- endif -%}
          </div>
          <div class="gift-feature__hero-content">
            {%- if block.settings.eyebrow != blank -%}
              <p class="gift-feature__eyebrow caption-with-letter-spacing">{{ block.settings.eyebrow | escape }}</p>
            {%- endif -%}
            {%- if block.settings.heading != blank -%}
              {%- if forloop.first -%}
                <h1 class="gift-feature__hero-heading {{ block.settings.heading_size }}">{{ block.settings.heading | escape }}</h1>
              {%- else -%}
                <h2 class="gift-feature__hero-heading {{ block.settings.heading_size }}">{{ block.settings.heading | escape }}</h2>
              {%- endif -%}
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="gift-feature__hero-text rte">{{ block.settings.text }}</div>
            {%- endif -%}
            {%- if block.settings.button_label != blank -%}
              <a
                {% if block.settings.button_link == blank %}
                  role="link" aria-disabled="true"
                {% else %}
                  href="{{ block.settings.button_link }}"
                {% endif %}
                class="button button--primary"
              >
                {{- block.settings.button_label | escape -}}
              </a>
            {%- endif -%}
          </div>
        </div>

      {%- when 'products' -%}
        {{ 'component-card.css' | asset_url | stylesheet_tag }}
        {{ 'component-price.css' | asset_url | stylesheet_tag }}
        {%- comment -%} 最初の商品ピックアップに、メインビジュアルのボタンから飛べるアンカーを付ける {%- endcomment -%}
        <div
          class="gift-feature__block gift-feature__products page-width"
          {% unless products_anchor_used %}
            id="gift-feature-products"
          {% endunless %}
          {{ block.shopify_attributes }}
        >
          {%- assign products_anchor_used = true -%}
          {%- render 'gift-feature-heading', block: block -%}
          <ul
            class="grid product-grid contains-card--product grid--2-col-tablet-down grid--{{ block.settings.columns_desktop }}-col-desktop"
            role="list"
          >
            {%- if block.settings.products != blank -%}
              {%- for product in block.settings.products -%}
                <li class="grid__item">
                  {% render 'card-product',
                    card_product: product,
                    media_aspect_ratio: 'square',
                    show_secondary_image: true,
                    skip_styles: true,
                    section_id: section.id
                  %}
                </li>
              {%- endfor -%}
            {%- else -%}
              {%- for i in (1..block.settings.columns_desktop) -%}
                <li class="grid__item">
                  {% render 'card-product', show_vendor: false, placeholder_image: 'product-apparel-1' %}
                </li>
              {%- endfor -%}
            {%- endif -%}
          </ul>
        </div>

      {%- when 'faq' -%}
        <div class="gift-feature__block gift-feature__faq page-width page-width--narrow" {{ block.shopify_attributes }}>
          {%- render 'gift-feature-heading', block: block -%}
          <div class="gift-feature__faq-list">
            {%- for i in (1..5) -%}
              {%- liquid
                assign question_key = 'question_' | append: i
                assign answer_key = 'answer_' | append: i
                assign question = block.settings[question_key]
                assign answer = block.settings[answer_key]
              -%}
              {%- if question != blank -%}
                <details class="gift-feature__faq-item"{% if i == 1 and block.settings.open_first %} open{% endif %}>
                  <summary class="gift-feature__faq-question">
                    <span>{{ question | escape }}</span>
                    {{- 'icon-caret.svg' | inline_asset_content -}}
                  </summary>
                  <div class="gift-feature__faq-answer rte">{{ answer }}</div>
                </details>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>

      {%- when 'cta' -%}
        <div class="gift-feature__block page-width" {{ block.shopify_attributes }}>
          <div class="gift-feature__cta color-{{ block.settings.color_scheme }} gradient content-container">
            {%- render 'gift-feature-heading', block: block -%}
            {%- if block.settings.text != blank -%}
              <div class="gift-feature__cta-text rte">{{ block.settings.text }}</div>
            {%- endif -%}
            {%- if block.settings.button_label != blank -%}
              <a
                {% if block.settings.button_link == blank %}
                  role="link" aria-disabled="true"
                {% else %}
                  href="{{ block.settings.button_link }}"
                {% endif %}
                class="button button--primary"
              >
                {{- block.settings.button_label | escape -}}
              </a>
            {%- endif -%}
          </div>
        </div>

      {%- when 'text' -%}
        <div class="gift-feature__block gift-feature__text page-width page-width--narrow center" {{ block.shopify_attributes }}>
          {%- render 'gift-feature-heading', block: block -%}
          {%- if block.settings.text != blank -%}
            <div class="rte">{{ block.settings.text }}</div>
          {%- endif -%}
        </div>
    {%- endcase -%}
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "t:sections.gift-feature.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 52
    }
  ],
  "blocks": [
    {
      "type": "hero",
      "name": "t:sections.gift-feature.blocks.hero.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.gift-feature.blocks.hero.settings.image.label"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "t:sections.gift-feature.blocks.hero.settings.eyebrow.label",
          "default": "Seasonal gifts"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.gift-feature.settings.heading.label",
          "default": "Autumn gift selection"
        },
        {
          "type": "select",
          "id": "heading_size",
          "label": "t:sections.gift-feature.settings.heading_size.label",
          "options": [
            { "value": "h2", "label": "t:sections.all.heading_size.options__1.label" },
            { "value": "h1", "label": "t:sections.all.heading_size.options__2.label" },
            { "value": "h0", "label": "t:sections.all.heading_size.options__3.label" }
          ],
          "default": "h1"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:sections.gift-feature.settings.text.label"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "t:sections.gift-feature.settings.button_label.label"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "t:sections.gift-feature.settings.button_link.label"
        },
        {
          "type": "select",
          "id": "text_alignment",
          "label": "t:sections.gift-feature.blocks.hero.settings.text_alignment.label",
          "options": [
            { "value": "left", "label": "t:sections.gift-feature.blocks.hero.settings.text_alignment.options__left.label" },
            { "value": "center", "label": "t:sections.gift-feature.blocks.hero.settings.text_alignment.options__center.label" }
          ],
          "default": "left"
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "min": 0,
          "max": 80,
          "step": 5,
          "unit": "%",
          "label": "t:sections.gift-feature.blocks.hero.settings.overlay_opacity.label",
          "default": 35
        },
        {
          "type": "range",
          "id": "min_height",
          "min": 40,
          "max": 90,
          "step": 5,
          "unit": "vh",
          "label": "t:sections.gift-feature.blocks.hero.settings.min_height.label",
          "default": 60
        },
        {
          "type": "checkbox",
          "id": "full_width",
          "label": "t:sections.gift-feature.blocks.hero.settings.full_width.label",
          "default": true
        },
        {
          "type": "color_scheme",
          "id": "color_scheme",
          "label": "t:sections.all.colors.label",
          "default": "scheme-3"
        }
      ]
    },
    {
      "type": "products",
      "name": "t:sections.gift-feature.blocks.products.name",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.gift-feature.settings.heading.label",
          "default": "Picked for gifting"
        },
        {
          "type": "select",
          "id": "heading_size",
          "label": "t:sections.gift-feature.settings.heading_size.label",
          "options": [
            { "value": "h2", "label": "t:sections.all.heading_size.options__1.label" },
            { "value": "h1", "label": "t:sections.all.heading_size.options__2.label" },
            { "value": "h0", "label": "t:sections.all.heading_size.options__3.label" }
          ],
          "default": "h2"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "t:sections.gift-feature.settings.subheading.label"
        },
        {
          "type": "product_list",
          "id": "products",
          "label": "t:sections.gift-feature.blocks.products.settings.products.label",
          "limit": 8
        },
        {
          "type": "range",
          "id": "columns_desktop",
          "min": 2,
          "max": 4,
          "step": 1,
          "label": "t:sections.gift-feature.blocks.products.settings.columns_desktop.label",
          "default": 3
        }
      ]
    },
    {
      "type": "faq",
      "name": "t:sections.gift-feature.blocks.faq.name",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.gift-feature.settings.heading.label",
          "default": "FAQ"
        },
        {
          "type": "select",
          "id": "heading_size",
          "label": "t:sections.gift-feature.settings.heading_size.label",
          "options": [
            { "value": "h2", "label": "t:sections.all.heading_size.options__1.label" },
            { "value": "h1", "label": "t:sections.all.heading_size.options__2.label" },
            { "value": "h0", "label": "t:sections.all.heading_size.options__3.label" }
          ],
          "default": "h2"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "t:sections.gift-feature.settings.subheading.label"
        },
        {
          "type": "checkbox",
          "id": "open_first",
          "label": "t:sections.gift-feature.blocks.faq.settings.open_first.label",
          "default": false
        },
        { "type": "header", "content": "Q1" },
        { "type": "text", "id": "question_1", "label": "t:sections.gift-feature.blocks.faq.settings.question.label" },
        { "type": "richtext", "id": "answer_1", "label": "t:sections.gift-feature.blocks.faq.settings.answer.label" },
        { "type": "header", "content": "Q2" },
        { "type": "text", "id": "question_2", "label": "t:sections.gift-feature.blocks.faq.settings.question.label" },
        { "type": "richtext", "id": "answer_2", "label": "t:sections.gift-feature.blocks.faq.settings.answer.label" },
        { "type": "header", "content": "Q3" },
        { "type": "text", "id": "question_3", "label": "t:sections.gift-feature.blocks.faq.settings.question.label" },
        { "type": "richtext", "id": "answer_3", "label": "t:sections.gift-feature.blocks.faq.settings.answer.label" },
        { "type": "header", "content": "Q4" },
        { "type": "text", "id": "question_4", "label": "t:sections.gift-feature.blocks.faq.settings.question.label" },
        { "type": "richtext", "id": "answer_4", "label": "t:sections.gift-feature.blocks.faq.settings.answer.label" },
        { "type": "header", "content": "Q5" },
        { "type": "text", "id": "question_5", "label": "t:sections.gift-feature.blocks.faq.settings.question.label" },
        { "type": "richtext", "id": "answer_5", "label": "t:sections.gift-feature.blocks.faq.settings.answer.label" }
      ]
    },
    {
      "type": "cta",
      "name": "t:sections.gift-feature.blocks.cta.name",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.gift-feature.settings.heading.label",
          "default": "Find the perfect gift"
        },
        {
          "type": "select",
          "id": "heading_size",
          "label": "t:sections.gift-feature.settings.heading_size.label",
          "options": [
            { "value": "h2", "label": "t:sections.all.heading_size.options__1.label" },
            { "value": "h1", "label": "t:sections.all.heading_size.options__2.label" },
            { "value": "h0", "label": "t:sections.all.heading_size.options__3.label" }
          ],
          "default": "h2"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "t:sections.gift-feature.settings.subheading.label"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:sections.gift-feature.settings.text.label"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "t:sections.gift-feature.settings.button_label.label",
          "default": "Shop all gifts"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "t:sections.gift-feature.settings.button_link.label"
        },
        {
          "type": "color_scheme",
          "id": "color_scheme",
          "label": "t:sections.all.colors.label",
          "default": "scheme-2"
        }
      ]
    },
    {
      "type": "text",
      "name": "t:sections.gift-feature.blocks.text.name",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.gift-feature.settings.heading.label"
        },
        {
          "type": "select",
          "id": "heading_size",
          "label": "t:sections.gift-feature.settings.heading_size.label",
          "options": [
            { "value": "h2", "label": "t:sections.all.heading_size.options__1.label" },
            { "value": "h1", "label": "t:sections.all.heading_size.options__2.label" },
            { "value": "h0", "label": "t:sections.all.heading_size.options__3.label" }
          ],
