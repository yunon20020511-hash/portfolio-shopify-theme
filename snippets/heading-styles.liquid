{% comment %}
  [カスタマイズ] 見出しのオーナー設定（テーマ設定「見出し（かんたん設定）」）を CSS に反映する

  - 日本語フォント：Shopify のフォントライブラリには日本語の書体がないため、選んだときだけ Google Fonts を読み込む
  - 太さ・文字間隔・色・スマートフォンでの大きさ
  base.css より後に読み込み、h0〜h5 と見出しクラスの指定を上書きする

  Usage:
  {% render 'heading-styles' %}
{% endcomment %}
{%- liquid
  assign jp_font_family = blank
  assign jp_font_query = blank
  case settings.heading_font_jp
    when 'noto_serif_jp'
      assign jp_font_family = "'Noto Serif JP', serif"
      assign jp_font_query = 'Noto+Serif+JP'
    when 'shippori_mincho'
      assign jp_font_family = "'Shippori Mincho', serif"
      assign jp_font_query = 'Shippori+Mincho'
    when 'zen_old_mincho'
      assign jp_font_family = "'Zen Old Mincho', serif"
      assign jp_font_query = 'Zen+Old+Mincho'
    when 'noto_sans_jp'
      assign jp_font_family = "'Noto Sans JP', sans-serif"
      assign jp_font_query = 'Noto+Sans+JP'
    when 'zen_maru_gothic'
      assign jp_font_family = "'Zen Maru Gothic', sans-serif"
      assign jp_font_query = 'Zen+Maru+Gothic'
  endcase

  # 読み込む太さは、設定で選んだ 1 種類だけにする（日本語フォントは太さごとに数百 KB になるため）
  if jp_font_query != blank
    assign jp_font_weight = settings.heading_weight
    if jp_font_weight == 'theme'
      assign jp_font_weight = '400'
    endif
    assign jp_font_query = jp_font_query | append: ':wght@' | append: jp_font_weight
  endif
-%}

{%- if jp_font_query != blank -%}
  {% # theme-check-disable RemoteAsset %}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  {%- comment -%}
    日本語フォントの CSS は大きい（約 55KB）ため、表示を止めないよう後から読み込む。
    読み込みまでは代わりのフォントで表示し、読み込み後に切り替わる（display=swap）
  {%- endcomment -%}
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family={{ jp_font_query }}&display=swap"
    media="print"
    onload="this.media='all'"
  >
  <noscript>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ jp_font_query }}&display=swap">
  </noscript>
  {% # theme-check-enable RemoteAsset %}
{%- endif -%}

{% style %}
  :root {
    {%- if jp_font_family != blank %}
      --font-heading-family: {{ jp_font_family }};
      --font-heading-style: normal;
    {%- endif %}
    {%- if jp_font_family != blank %}
      --font-heading-weight: {{ jp_font_weight }};
    {%- elsif settings.heading_weight != 'theme' %}
      --font-heading-weight: {{ settings.heading_weight }};
    {%- endif %}
  }

  h1, h2, h3, h4, h5, .h0, .h1, .h2, .h3, .h4, .h5 {
    letter-spacing: {{ settings.heading_letter_spacing | divided_by: 100.0 }}em;
  }

  {%- if settings.heading_color != blank and settings.heading_color.alpha != 0.0 %}
    /* 色は基本の配色（スキーム1）の上の見出しだけに使う。濃い背景のセクションで読めなくなるのを防ぐ */
    .color-scheme-1 :is(h1, h2, h3, h4, h5, .h0, .h1, .h2, .h3, .h4, .h5) {
      color: {{ settings.heading_color }};
    }
  {%- endif %}

  @media screen and (max-width: 749px) {
    :root {
      --font-heading-scale: calc({{ settings.heading_scale | times: 1.0 | divided_by: settings.body_scale }} * {{ settings.heading_scale_mobile | divided_by: 100.0 }});
    }
  }
{% endstyle %}
